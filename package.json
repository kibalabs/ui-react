{
  "name": "@kibalabs/ui-react",
  "version": "0.12.0",
  "description": "React UI component library for building projects at Kiba Labs (with toasts and dropzones)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibalabs/ui-react.git"
  },
  "homepage": "https://ui-react-docs.kibalabs.com",
  "bugs": "https://github.com/kibalabs/ui-react/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "import": "./dist/toast/index.js",
      "default": "./dist/toast/index.js"
    },
    "./dropzone": {
      "types": "./dist/dropzone/index.d.ts",
      "import": "./dist/dropzone/index.js",
      "default": "./dist/dropzone/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vitePlugin/index.d.ts",
      "import": "./dist/vitePlugin/index.js",
      "default": "./dist/vitePlugin/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./styles.scss": "./src/styles/all.scss",
    "./toast/styles.css": "./dist/toast/index.css",
    "./toast/styles.scss": "./src/toast/styles.scss",
    "./dropzone/styles.css": "./dist/dropzone/index.css",
    "./dropzone/styles.scss": "./src/dropzone/styles.scss"
  },
  "files": [
    "dist/*",
    "src/styles/*.scss",
    "src/particles/*/styles.scss",
    "src/layouts/*/styles.scss",
    "src/atoms/*/styles.scss",
    "src/molecules/*/styles.scss",
    "src/wrappers/*/styles.scss",
    "src/toast/styles.scss",
    "src/dropzone/styles.scss"
  ],
  "dependencies": {
    "@kibalabs/core": "^0.7.2-next.10",
    "lazysizes": "^5.3.2",
    "markdown-to-jsx": "^9.10.3"
  },
  "devDependencies": {
    "@kibalabs/build": "0.14.2-next.16",
    "@material-design-icons/svg": "0.14.15",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bootstrap-icons": "1.13.2",
    "feather-icons": "4.29.2",
    "ionicons": "8.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.4",
    "react-hot-toast": "2.6.1",
    "react-router": "8.5.0",
    "remark-gfm": "4.0.1",
    "remixicon": "4.9.1",
    "storybook": "10.6.4"
  },
  "peerDependencies": {
    "@material-design-icons/svg": ">=0.14.0",
    "bootstrap-icons": "^1.0.0",
    "feather-icons": "^4.0.0",
    "ionicons": ">=7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^20.1.4",
    "react-hot-toast": "^2.6.1",
    "react-router": "^8.5.0",
    "remixicon": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@material-design-icons/svg": {
      "optional": true
    },
    "bootstrap-icons": {
      "optional": true
    },
    "feather-icons": {
      "optional": true
    },
    "ionicons": {
      "optional": true
    },
    "react-dropzone": {
      "optional": true
    },
    "react-hot-toast": {
      "optional": true
    },
    "remixicon": {
      "optional": true
    }
  }
}
